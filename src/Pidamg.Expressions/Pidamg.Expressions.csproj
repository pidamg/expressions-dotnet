<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Pidamg.Expressions</PackageId>
    <Title>Pidamg.Expressions</Title>
    <RootNamespace>Pidamg.Expressions</RootNamespace>
    <IsPackable>true</IsPackable>
    <Version>0.0.0-dev</Version>
    <Description>An embeddable, host-neutral .NET expression engine with typed evaluation, null-safe navigation, scoped contexts, and string interpolation.</Description>
    <PackageTags>expressions;evaluation;parser;interpolation;ast</PackageTags>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/pidamg/expressions-dotnet/releases/tag/v$(Version)</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/package-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
